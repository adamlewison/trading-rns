# Keys this project uses, and WHERE each one lives. Never commit real values, never paste them in chat.
#
# Two places hold keys:
#  1. Cloud sessions (where agents work): keys are saved in the cloud environment's settings as
#     "network secrets" (environment menu -> Edit -> Network secrets). The session's proxy adds them
#     to requests for that host, so agents use them without ever seeing them. No .env file there.
#  2. The droplet: /opt/trading-rns-us/.env and /opt/trading-rns/.env (this file's format).
#
# With these in place an agent can do everything itself: read/write B2, call the LLM APIs, and run
# commands on the droplet through `core.remote` (B2 job queue; cloud sessions cannot SSH).

# --- Backblaze B2 (bucket name in config.yaml) -----------------------------------------------
# droplet: here | cloud session: network secret for api.backblazeb2.com (basic auth: key id + app key)
B2_KEY_ID=
B2_APP_KEY=

# --- SEC EDGAR (not a secret, but required: "Name email") ------------------------------------
SEC_USER_AGENT=

# --- LLM APIs ----------------------------------------------------------------------------------
# droplet: here | cloud session: network secret for api.openai.com (Bearer)
OPENAI_API_KEY=
# droplet only (cloud sessions route api.anthropic.com around the proxy, so no injection there)
ANTHROPIC_API_KEY=
# cloud session: network secret for ai-gateway.vercel.sh (model comparisons only)
AI_GATEWAY_API_KEY=

# --- Live alerts (later) -----------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
